# She2Be environment variables
# Copy this file to .env and adjust as needed.

# ============================================================================
# Database
# ============================================================================

# SQLite (dev) — for PostgreSQL, use: postgresql://user:pass@localhost:5432/she2be
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================================================
# App
# ============================================================================

NODE_ENV=development

# Session signing secret — generate a long random string for production.
# In dev, a deterministic fallback is used if this is unset.
# SESSION_SECRET=replace-with-a-long-random-string

# ============================================================================
# Payment providers — set only the ones you want to enable.
# Each is optional. Any unset provider is hidden from checkout.
# ============================================================================

# Cash on Delivery is always enabled (no config needed).

# Stripe (international cards)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Paymob (Egyptian cards + wallets)
# PAYMOB_API_KEY=xxx
# PAYMOB_MERCHANT_ID=xxx
# PAYMOB_INTEGRATION_ID=xxx
# PAYMOB_APPLE_PAY_INTEGRATION_ID=xxx
# PAYMOB_IFRAME_ID=xxx
# PAYMOB_WEBHOOK_HMAC=xxx

# Fawry (pay at kiosk / ATM)
# FAWRY_MERCHANT_CODE=xxx
# FAWRY_SECURITY_KEY=xxx
# FAWRY_SANDBOX=true

# InstaPay (instant bank transfer)
# INSTAPAY_MERCHANT_EMAIL=adsal@instapay
# INSTAPAY_API_KEY=xxx
# INSTAPAY_WEBHOOK_SECRET=xxx
# INSTAPAY_API_BASE=https://api.instapay.example.com/v1  # replace once you have official API access

# Vodafone Cash
# VODAFONE_CASH_MERCHANT_MSISDN=010xxxxxxxx
# VODAFONE_CASH_API_KEY=xxx
# VODAFONE_CASH_USERNAME=xxx
# VODAFONE_CASH_PASSWORD=xxx
# VODAFONE_CASH_WEBHOOK_SECRET=xxx

# Apple Pay (uses Stripe or Paymob as processor)
# APPLE_PAY_MERCHANT_ID=merchant.com.she2be
# APPLE_PAY_PROCESSOR=stripe  # or 'paymob'
# APPLE_PAY_DOMAIN_VERIFICATION=xxx

# ============================================================================
# Maps
# ============================================================================

# Default: OpenStreetMap (free, no key needed). For higher volume, use:
# MAPS_PROVIDER=osm|mapbox|google

# Mapbox (optional)
# MAPBOX_ACCESS_TOKEN=pk.xxx

# Google Maps (optional)
# GOOGLE_MAPS_API_KEY=xxx

# ============================================================================
# Email (transactional) — for future use
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_USER=
# SMTP_PASS=

# ============================================================================
# ERPNext (future integration)
# ============================================================================

# ERP_NEXT_BASE_URL=
# ERP_NEXT_API_KEY=
# ERP_NEXT_API_SECRET=
