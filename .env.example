# She2Be environment variables
# Copy this file to .env and adjust as needed.

# SQLite (dev) — for PostgreSQL, use: postgresql://user:pass@localhost:5432/she2be
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret — generate a long random string for production.
# In dev, a deterministic fallback is used if this is unset.
# SESSION_SECRET=replace-with-a-long-random-string

# Node environment
NODE_ENV=development
